{
  "multipart": [
    {
      "apply": {
        "model": "the_oldest_house:block/ward_glass_post"
      }
    },
    {
      "when": {
        "north": "true"
      },
      "apply": {
        "model": "the_oldest_house:block/ward_glass_side"
      }
    },
    {
      "when": {
        "north": "false"
      },
      "apply": {
        "model": "the_oldest_house:block/ward_glass_noside"
      }
    },
    {
      "when": {
        "east": "true"
      },
      "apply": {
        "model": "the_oldest_house:block/ward_glass_side",
        "y": 90
      }
    },
    {
      "when": {
        "east": "false"
      },
      "apply": {
        "model": "the_oldest_house:block/ward_glass_noside",
        "y": 90
      }
    },
    {
      "when": {
        "south": "true"
      },
      "apply": {
        "model": "the_oldest_house:block/ward_glass_side",
        "y": 180
      }
    },
    {
      "when": {
        "south": "false"
      },
      "apply": {
        "model": "the_oldest_house:block/ward_glass_noside",
        "y": 180
      }
    },
    {
      "when": {
        "west": "true"
      },
      "apply": {
        "model": "the_oldest_house:block/ward_glass_side",
        "y": 270
      }
    },
    {
      "when": {
        "west": "false"
      },
      "apply": {
        "model": "the_oldest_house:block/ward_glass_noside",
        "y": 270
      }
    }
  ]
