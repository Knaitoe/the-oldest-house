{
  "multipart": [
    {
      "apply": {
        "model": "the_oldest_house:block/trail_knot"
      }
    },
    {
      "when": {
        "north": "true"
      },
      "apply": {
        "model": "the_oldest_house:block/trail_north",
        "y": 0
      }
    },
    {
      "when": {
        "east": "true"
      },
      "apply": {
        "model": "the_oldest_house:block/trail_north",
        "y": 90
      }
    },
    {
      "when": {
        "south": "true"
      },
      "apply": {
        "model": "the_oldest_house:block/trail_north",
        "y": 180
      }
    },
    {
      "when": {
        "west": "true"
      },
      "apply": {
        "model": "the_oldest_house:block/trail_north",
        "y": 270
      }
    }
  ]
}
